# This Gurux flag allows to customize malloc implementation.
# It deactivates the redefinition of gxmalloc, gxfree, ...
# as well as supresses the inclusion of stdlib.h
GURUX_FLAGS += -DDLMS_USE_CUSTOM_MALLOC
# Use EPOCH time. This can be used to improve memory usage.
GURUX_FLAGS += -DDLMS_USE_EPOCH_TIME
# Use UTC time zone. Read more: https://www.gurux.fi/Gurux.DLMS.Objects.GXDLMSClock
GURUX_FLAGS += -DDLMS_USE_UTC_TIME_ZONE


ifeq ($(safe_malloc), min)
# The min configuration is the full configuration with the SFMALLOC_SAVE_SPACE flag
GURUX_FLAGS += -DSFMALLOC_SAVE_SPACE
safe_malloc = yes
endif

ifeq ($(safe_malloc), yes)
# When safe malloc is enabled, gxmalloc, gxfree, ... are redefined as
# their safe malloc counterparts but we also need to use the -include directive
# to automatically inject sfmalloc.h header file in every source file that
# will be compiled
GURUX_FLAGS += -DUSE_SAFE_MALLOC -Dgxfree=sf_free -Dgxmalloc=sf_malloc -Dgxcalloc=sf_calloc -Dgxrealloc=sf_realloc -include sfmalloc.h
# The definitions hereunder are used to enable safe malloc without making
# the Gurux DLMS git repo dirty
else
# When safe malloc is disabled, gxmalloc, gxfree, ... are redefined as
# the stdlib malloc, free, .. but we also have to use -include directive
# to automatically inject stdlib.h header file in every source file that
# will be compiled
GURUX_FLAGS += -Dgxfree=free -Dgxmalloc=malloc -Dgxcalloc=calloc -Dgxrealloc=realloc -include stdlib.h
endif


